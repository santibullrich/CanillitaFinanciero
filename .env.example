# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en el servidor. Nunca la expongas con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Datos de mercado: Yahoo Finance, gratis y sin clave.

# Claude API (solo servidor)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# Finnhub (gratis, https://finnhub.io/register): ficha de empresa, ratios y analistas. Secreta: solo en el servidor.
FINNHUB_API_KEY=

# logo.dev: clave PÚBLICA (pk_...). La secreta (sk_...) no va acá.
NEXT_PUBLIC_LOGO_DEV_TOKEN=

# URL pública del sitio (en Vercel: https://tu-app.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
